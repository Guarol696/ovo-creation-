# EMPIRE — copier en .env.local. Sans aucune variable, le site tourne en MODE DÉMONSTRATION :
# formations gratuites accessibles, progression enregistrée dans le navigateur,
# paiements désactivés, assistant IA en prévisualisation.

# ─── Identité (publiques) ──────────────────────────────────────────
NEXT_PUBLIC_BRAND_NAME=EMPIRE
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=
# Réseaux sociaux : un lien n'apparaît que si son URL est renseignée.
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_X=
# Vidéos des leçons (par défaut : films libres Blender Foundation, à des fins de test).
NEXT_PUBLIC_DEMO_VIDEO_BASE=

# ─── Supabase : comptes, progression, projets ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVEUR UNIQUEMENT (webhook Stripe, checkout). Ne jamais préfixer NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Stripe : abonnements Pro / Premium (serveur uniquement) ──────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=

# ─── Assistant IA (serveur uniquement) ────────────────────────────
ANTHROPIC_API_KEY=
# Optionnel (défaut : claude-opus-5-5)
ASSISTANT_MODEL=
