# Copie ce fichier en `.env.local` et renseigne tes valeurs.
# Ne commite JAMAIS `.env.local` (il est ignoré par git).

# URL publique du site (métadonnées, sitemap, partage… et liens des emails de compte)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings > API (comptes et voyages enregistrés ; facultatif).
# Ces deux valeurs sont publiques par conception : les données sont protégées par les règles RLS.
# Sans elles, OVO fonctionne sans compte (les pages de compte l'indiquent).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Fond de carte (facultatif) : par défaut, tuiles gratuites CARTO (© OpenStreetMap).
# Pour la production à fort trafic, utiliser un fournisseur avec clé (MapTiler, Mapbox…).
# NEXT_PUBLIC_MAP_TILES_URL=https://api.maptiler.com/maps/streets-v2-dark/{z}/{x}/{y}.png?key=VOTRE_CLE
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap

# ---------------------------------------------------------------------------
# Abonnements OVO Medium / OVO Premium (Stripe)
# Laisser vide tant que Stripe n'est pas configuré : le site fonctionne, les
# boutons de paiement affichent « Le paiement n'est pas encore activé ».
# Utiliser d'abord les clés de TEST (sk_test_…, pk_test_…).
# ---------------------------------------------------------------------------

# Clé publiable (publique par conception, Developers > API keys). Non indispensable
# avec Stripe Checkout hébergé, prévue pour de futurs éléments Stripe côté navigateur.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# SECRET — serveur uniquement, jamais préfixé NEXT_PUBLIC_ (Developers > API keys).
STRIPE_SECRET_KEY=

# SECRET — signature des webhooks (Developers > Webhooks > ton endpoint > Signing secret,
# ou affiché par `stripe listen` en local). Endpoint : https://<domaine>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Identifiants des prix mensuels (Product catalog > produit > Prices > price_…).
# Les montants affichés sur le site sont dans src/config/premium.ts : garder les mêmes.
STRIPE_MEDIUM_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=

# Facultatif : configuration précise du portail client (Settings > Billing > Customer portal).
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_...

# SECRET — clé « service_role » Supabase (Project Settings > API) : utilisée UNIQUEMENT
# par le serveur pour enregistrer l'abonnement reçu de Stripe (la table n'est pas
# modifiable par les utilisateurs). Ne jamais l'exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# Tests locaux uniquement (stripe-mock ou simulateur) — ignorée avec une clé live.
# STRIPE_API_BASE=http://localhost:12111

# Clés secrètes côté serveur uniquement (jamais préfixées par NEXT_PUBLIC_).
# À ajouter lors des prochaines étapes :
# AI_API_KEY=
# FLIGHTS_API_KEY=
# HOTELS_API_KEY=
