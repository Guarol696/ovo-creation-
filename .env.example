# Copie ce fichier en `.env.local` et renseigne tes valeurs.
# Ne commite JAMAIS `.env.local` (il est ignoré par git).

# URL publique du site (métadonnées, sitemap, partage… et liens des emails de compte)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings > API (comptes et voyages enregistrés ; facultatif).
# Ces deux valeurs sont publiques par conception : les données sont protégées par les règles RLS.
# Sans elles, OVO fonctionne sans compte (les pages de compte l'indiquent).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Fond de carte (facultatif) : par défaut, tuiles gratuites CARTO (© OpenStreetMap).
# Pour la production à fort trafic, utiliser un fournisseur avec clé (MapTiler, Mapbox…).
# NEXT_PUBLIC_MAP_TILES_URL=https://api.maptiler.com/maps/streets-v2-dark/{z}/{x}/{y}.png?key=VOTRE_CLE
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap

# Clés secrètes côté serveur uniquement (jamais préfixées par NEXT_PUBLIC_).
# À ajouter lors des prochaines étapes :
# SUPABASE_SERVICE_ROLE_KEY=   (non utilisée : ne jamais l'exposer au navigateur)
# AI_API_KEY=
# FLIGHTS_API_KEY=
# HOTELS_API_KEY=
# STRIPE_SECRET_KEY=
